# Salin file ini menjadi .env lalu isi. JANGAN pernah bagikan file .env ke siapa pun.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
GEMINI_API_KEY=
# Model gambar Gemini (menerima gambar referensi maskot). Nama bisa berubah; cek di Google AI Studio.
MODEL_GAMBAR=gemini-3.1-flash-image
# Kosongkan dulu = tanpa klip video AI (gambar digerakkan editor). Diisi nanti setelah kita uji model video.
MODEL_VIDEO=

# Jam tayang WITA (0-23), pisahkan dengan koma
JAM_TAYANG_SHORTS=12,18
JAM_TAYANG_PANJANG=19
