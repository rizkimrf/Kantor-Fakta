# Salin file ini menjadi .env lalu isi. JANGAN pernah bagikan file .env ke siapa pun.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Kosongkan = otomatis pilih model eleven_v4 terbaru di akun
ELEVENLABS_MODEL=
GEMINI_API_KEY=
# Model gambar Gemini (menerima gambar referensi maskot). Nama bisa berubah; cek di Google AI Studio.
MODEL_GAMBAR=gemini-3.1-flash-image
# Kosongkan dulu = tanpa klip video AI (gambar digerakkan editor). Diisi nanti setelah kita uji model video.
MODEL_VIDEO=

# Jam tayang WITA (0-23), pisahkan dengan koma
JAM_TAYANG_SHORTS=12,18
JAM_TAYANG_PANJANG=19

# ---- Unggah otomatis (isi di pengaturan environment claude.ai/code, BUKAN di chat) ----
# YouTube: dari client_secret.json + scripts/login_youtube.py
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# TikTok: aplikasi di developers.tiktok.com (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# inbox = masuk kotak masuk TikTok, Bos tekan Posting (sebelum audit) | direct = langsung tayang (setelah audit TikTok)
TIKTOK_MODE=inbox
# Instagram: Instagram API dengan login Instagram (akun profesional). Token berlaku 60 hari.
IG_USER_ID=
IG_ACCESS_TOKEN=
